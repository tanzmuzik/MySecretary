{
  "name": "urusee-notifier",
  "version": "1.0.0",
  "description": "タスクトレイ常駐型「うるせぇ！」通知アプリ",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"npm run start:server\" \"npm run start:electron\"",
    "start:server": "node server.js",
    "start:electron": "wait-on tcp:5555 && electron .",
    "dev": "concurrently \"npm run start:server\" \"npm run dev:webpack\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:webpack": "webpack serve --mode development",
    "build": "webpack --mode production",
    "build:win": "electron-builder --win",
    "package": "npm run build && electron-builder"
  },
  "keywords": [
    "electron",
    "tray",
    "notification",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/ws": "^8.5.8",
    "concurrently": "^8.2.2",
    "css-loader": "^6.8.1",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "html-webpack-plugin": "^5.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.0",
    "typescript": "^5.2.2",
    "wait-on": "^7.2.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "build": {
    "appId": "com.urusee.notifier",
    "productName": "UruseeNotifier",
    "compression": "maximum",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "preload.js",
      "build/**/*",
      "assets/**/*",
      "!**/*.md",
      "!**/*.ts",
      "!**/*.map",
      "!src/**/*"
    ],
    "win": {
      "target": {
        "target": "nsis",
        "arch": ["x64"]
      },
      "icon": "assets/icon.png",
      "compression": "maximum"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "assets/icon.png",
      "uninstallerIcon": "assets/icon.png",
      "installerHeaderIcon": "assets/icon.png",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "UruseeNotifier",
      "deleteAppDataOnUninstall": true
    }
  }
}
