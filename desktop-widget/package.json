{
  "name": "desktop-widget",
  "version": "1.0.0",
  "description": "Desktop widget with clock, calendar, and alarm features",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder"
  },
  "keywords": ["electron", "widget", "clock", "calendar", "alarm"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.desktop.widget",
    "productName": "Desktop Widget",
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "dist"
    }
  }
}
